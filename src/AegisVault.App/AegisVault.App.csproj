<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>AegisVault.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AtomUI.Desktop.Controls" />
    <PackageReference Include="AtomUI.Desktop.Controls.ColorPicker" />
    <PackageReference Include="AtomUI.Icons.AntDesign" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AegisVault.Core\AegisVault.Core.csproj" />
    <ProjectReference Include="..\AegisVault.Platform\AegisVault.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <!--
    macOS NativeAOT: Xcode 16+ SDKs ship the componentized Swift compatibility
    libraries (swift_time, swiftsys_time, swiftunistd, …); the ILC link step
    fails with "Could not find or use auto-linked library 'swift_time'" unless
    the search paths below are handed to the linker. Both are added because the
    SDK only carries stubs while the real dylibs live in the Xcode toolchain
    (dotnet/runtime#125858; keep the SDK path for older layouts).
  -->
  <Target Name="AddMacOsSwiftLibraryPaths"
          BeforeTargets="LinkNative"
          Condition="$([MSBuild]::IsOSPlatform('osx')) And '$(PublishAot)' == 'true'">
    <Exec Command="xcrun --show-sdk-path"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MacSdkPath" />
    </Exec>
    <Exec Command="xcode-select -p"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_MacXcodePath" />
    </Exec>
    <PropertyGroup>
      <_MacSdkPath>$([System.String]::Copy('$(_MacSdkPath)').Trim())</_MacSdkPath>
      <_MacXcodePath>$([System.String]::Copy('$(_MacXcodePath)').Trim())</_MacXcodePath>
      <_MacToolchainSwiftPath>$(_MacXcodePath)/Toolchains/XcodeDefault.xctoolchain/usr/lib/swift/macosx</_MacToolchainSwiftPath>
    </PropertyGroup>
    <ItemGroup>
      <LinkerArg Include="-L$(_MacSdkPath)/usr/lib/swift"
                 Condition="Exists('$(_MacSdkPath)/usr/lib/swift')" />
      <LinkerArg Include="-L$(_MacToolchainSwiftPath)"
                 Condition="Exists('$(_MacToolchainSwiftPath)')" />
    </ItemGroup>
    <Warning Text="AddMacOsSwiftLibraryPaths: no Swift library search path found (sdk='$(_MacSdkPath)', toolchain='$(_MacToolchainSwiftPath)')"
             Condition="!Exists('$(_MacSdkPath)/usr/lib/swift') And !Exists('$(_MacToolchainSwiftPath)')" />
  </Target>

</Project>
