<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:controls="using:AegisVault.App.Controls"
        xmlns:atom="https://atomui.net"
        x:Class="AegisVault.App.Views.ConfirmWindow"
        Icon="/Assets/app.png"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{atom:SharedTokenResource ColorBgContainer}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
    <Grid RowDefinitions="40,*">
        <controls:AegisTitleBar x:Name="TitleBar" Grid.Row="0" ShowIcon="True" />

        <StackPanel Grid.Row="1" Margin="20" Spacing="18">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <atom:Button x:Name="CancelButton"
                             Content="{loc:Str Common_Cancel}"
                             Click="OnCancelClicked"
                             IsCancel="True" />
                <atom:Button x:Name="OkButton"
                             ButtonType="Primary"
                             Content="{loc:Str Common_Ok}"
                             Click="OnOkClicked"
                             IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
