<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AegisVault.App.Localization"
        x:Class="AegisVault.App.Views.ConfirmWindow"
        Icon="/Assets/app.png"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{loc:Str Common_Cancel}" Click="OnCancelClicked" IsCancel="True" />
            <Button Content="{loc:Str Common_Ok}" Click="OnOkClicked" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
