<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:atom="https://atomui.net"
        xmlns:antd="https://atomui.net/icons/antdesign"
        x:Class="AegisVault.App.Views.FloatingBallWindow"
        Width="52" Height="52"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">
    <Window.Styles>
        <Style Selector="Button.ball">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
        </Style>
        <Style Selector="Button.ball:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryHover}" />
        </Style>
        <Style Selector="Button.ball:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimaryActive}" />
        </Style>
    </Window.Styles>

    <Panel>
        <Button x:Name="BallButton"
                Classes="ball"
                Width="44" Height="44"
                Padding="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="22"
                Foreground="White"
                ToolTip.Tip="{loc:Str Ball_Tooltip}"
                PointerPressed="OnBallPointerPressed"
                PointerMoved="OnBallPointerMoved"
                PointerReleased="OnBallPointerReleased">
            <!-- Colour must go through a Button: AtomUI icons ignore host/parent
                 Foreground and PathIcon type selectors (see pitfall P-06). The button
                 stays hit-test transparent so the ball keeps its drag handlers. -->
            <atom:Button ButtonType="Text"
                         IsHitTestVisible="False"
                         Focusable="False"
                         Width="22" Height="22"
                         MinWidth="0" MinHeight="0"
                         Padding="0"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="White"
                         Icon="{antd:AntDesignIconProvider SafetyCertificateFilled}" />
        </Button>
    </Panel>
</Window>
