<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AegisVault.App.Localization"
        x:Class="AegisVault.App.Views.SplashWindow"
        Icon="/Assets/app.png"
        Title="{loc:Str App_Title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent">
    <!-- Deliberately plain Avalonia: the splash has to render before AtomUI
         finishes its theme initialisation, so it must not use AtomUI controls,
         tokens or styles. Colours come from AppTheme.TokenColor in code-behind
         (app-owned token table). -->
    <Border x:Name="Card"
            Margin="24"
            CornerRadius="14"
            BorderThickness="1"
            Padding="30,28,30,24">
        <StackPanel Spacing="6">
            <Border x:Name="IconTile"
                    Width="52" Height="52"
                    CornerRadius="14"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10">
                <Grid Width="26" Height="26"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Path x:Name="ShieldPath"
                          Data="M 12,0 L 23,5 L 23,13 C 23,19.5 18.5,23.5 12,25.5 C 5.5,23.5 1,19.5 1,13 L 1,5 Z"
                          Stretch="Uniform" />
                    <Ellipse x:Name="ShieldCore"
                             Width="6" Height="6"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Margin="0,-3,0,0" />
                </Grid>
            </Border>

            <TextBlock Text="{loc:Str App_Title}"
                       x:Name="TitleText"
                       FontSize="20"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center" />

            <TextBlock x:Name="SubtitleText"
                       Text="{loc:Str Unlock_Subtitle}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="Progress"
                         Height="4"
                         Minimum="0"
                         Maximum="1"
                         Value="0.1"
                         Margin="0,16,0,0" />

            <TextBlock x:Name="StatusText"
                       Text="{loc:Str Splash_Preparing}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</Window>
