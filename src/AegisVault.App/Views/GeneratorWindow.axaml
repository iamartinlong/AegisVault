<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:controls="using:AegisVault.App.Controls"
        xmlns:atom="https://atomui.net"
        xmlns:antd="https://atomui.net/icons/antdesign"
        x:Class="AegisVault.App.Views.GeneratorWindow"
        x:DataType="vm:GeneratorViewModel"
        Icon="/Assets/app.png"
        Title="{loc:Str Generator_Title}"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AegisSidebarBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
    <Grid RowDefinitions="40,*">
        <controls:AegisTitleBar Grid.Row="0"
                                Title="{loc:Str Generator_Title}"
                                ShowIcon="True" />

        <Border Grid.Row="1"
                Background="{atom:SharedTokenResource ColorBgLayout}"
                Padding="20">
            <Border Classes="card" Padding="20" BoxShadow="0 4 16 0 #14000000">
                <StackPanel Spacing="14">
                    <Border Background="{DynamicResource AegisHoverBrush}"
                            CornerRadius="10"
                            Padding="16,14">
                        <StackPanel Spacing="10">
                            <SelectableTextBlock Text="{Binding Password}"
                                                 FontFamily="Consolas, Menlo, monospace"
                                                 FontSize="18"
                                                 TextWrapping="Wrap" />
                            <atom:ProgressBar Value="{Binding StrengthPercent}"
                                              Maximum="100"
                                              Height="6"
                                              HorizontalAlignment="Stretch" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding StrengthSummary}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding EntropyText}"
                                           FontSize="12"
                                           Opacity="0.55"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="field" Text="{loc:Str Generator_Length}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LengthText}"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </Grid>
                        <atom:Slider Minimum="8"
                                     Maximum="64"
                                     TickFrequency="1"
                                     IsSnapToTickEnabled="True"
                                     Value="{Binding Length}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                        <atom:CheckBox Grid.Row="0" Grid.Column="0"
                                       Content="{loc:Str Generator_Lowercase}"
                                       IsChecked="{Binding IncludeLowercase}" />
                        <atom:CheckBox Grid.Row="0" Grid.Column="1"
                                       Content="{loc:Str Generator_Uppercase}"
                                       IsChecked="{Binding IncludeUppercase}" />
                        <atom:CheckBox Grid.Row="1" Grid.Column="0"
                                       Content="{loc:Str Generator_Digits}"
                                       IsChecked="{Binding IncludeDigits}" />
                        <atom:CheckBox Grid.Row="1" Grid.Column="1"
                                       Content="{loc:Str Generator_Symbols}"
                                       IsChecked="{Binding IncludeSymbols}" />
                        <atom:CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                       IsChecked="{Binding ExcludeAmbiguous}">
                            <TextBlock Text="{loc:Str Generator_ExcludeAmbiguous}" TextWrapping="Wrap" />
                        </atom:CheckBox>
                    </Grid>

                    <TextBlock Text="{Binding CopyStatus}"
                               Foreground="{atom:SharedTokenResource ColorSuccess}"
                               MinHeight="18" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <atom:Button ButtonType="Default"
                                     Icon="{antd:AntDesignIconProvider ThunderboltOutlined}"
                                     Content="{loc:Str Generator_Regenerate}"
                                     Command="{Binding RegenerateCommand}" />
                        <atom:Button ButtonType="Default"
                                     Icon="{antd:AntDesignIconProvider CopyOutlined}"
                                     Content="{loc:Str Common_Copy}"
                                     Command="{Binding CopyPasswordCommand}" />
                        <atom:Button ButtonType="Primary"
                                     Icon="{antd:AntDesignIconProvider CheckOutlined}"
                                     Content="{loc:Str Generator_Use}"
                                     Click="OnUseClicked"
                                     IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
