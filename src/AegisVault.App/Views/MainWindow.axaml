<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:models="using:AegisVault.Core.Models"
        x:Class="AegisVault.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.png"
        Title="AegisVault"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Panel>
        <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,14,20,10">
            <TextBlock Grid.Column="0"
                       Text="AegisVault"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusMessage}"
                       Margin="16,0"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="＋ 新建条目" Command="{Binding AddEntryCommand}" />
                <Button Content="生成器" Click="OnGeneratePasswordClicked" />
                <Button Content="设置" Click="OnSettingsClicked" />
                <Button Content="锁定" Command="{Binding LockCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="210,4,330,4,*" Margin="12,0,12,12">
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:CategoryItem">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding DisplayName}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Count}"
                                       FontSize="11"
                                       Opacity="0.5"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" />

            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <TextBox x:Name="SearchBox"
                         Grid.Row="0"
                         Text="{Binding SearchText}"
                         PlaceholderText="搜索标题、用户名、网址、标签" />
                <Panel Grid.Row="1" Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding FilteredEntries}"
                             SelectedItem="{Binding SelectedEntry}">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem StackPanel.rowActions">
                                <Setter Property="Opacity" Value="0" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover StackPanel.rowActions">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="ListBoxItem:selected StackPanel.rowActions">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:PasswordEntry">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="★"
                                                       Foreground="#FAAD14"
                                                       IsVisible="{Binding IsFavorite}" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Classes="rowActions"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <Button Content="👤"
                                                ToolTip.Tip="复制用户名"
                                                Click="OnRowCopyUsernameClicked" />
                                        <Button Content="🔑"
                                                ToolTip.Tip="复制密码"
                                                Click="OnRowCopyPasswordClicked" />
                                        <Button Content="⏱"
                                                ToolTip.Tip="复制验证码"
                                                IsVisible="{Binding TotpSecret, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                Click="OnRowCopyTotpClicked" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="没有可显示的条目"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.45"
                               IsVisible="{Binding !HasFilteredEntries}" />
                </Panel>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" Background="Transparent" />

            <Panel Grid.Column="4">
                <TextBlock Text="选择一个条目查看详情"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.45"
                           IsVisible="{Binding !HasSelection}" />

                <ScrollViewer IsVisible="{Binding HasSelection}">
                    <Grid>
                        <StackPanel Margin="10,4,4,4" Spacing="12" IsVisible="{Binding !IsEditing}">
                            <TextBlock Text="{Binding EditTitle}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="用户名" FontSize="12" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Text="{Binding EditUsername}"
                                                         VerticalAlignment="Center"
                                                         TextWrapping="Wrap" />
                                    <Button Grid.Column="2"
                                            Content="复制"
                                            Command="{Binding CopyUsernameCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="密码" FontSize="12" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,8,Auto,Auto">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Text="{Binding PasswordPreview}"
                                                         FontFamily="Consolas, Menlo, monospace"
                                                         VerticalAlignment="Center"
                                                         TextWrapping="Wrap" />
                                    <Button Grid.Column="2"
                                            Content="显示"
                                            Command="{Binding TogglePasswordRevealCommand}" />
                                    <Button Grid.Column="3"
                                            Margin="8,0,0,0"
                                            Content="复制"
                                            Command="{Binding CopyPasswordCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4" IsVisible="{Binding HasTotp}">
                                <TextBlock Text="动态验证码" FontSize="12" Opacity="0.6" />
                                <Grid ColumnDefinitions="Auto,8,*,8,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TotpCode}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               FontFamily="Consolas, Menlo, monospace" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding TotpRemaining, StringFormat='{}{0}s'}"
                                               Opacity="0.6"
                                               VerticalAlignment="Bottom" />
                                    <Button Grid.Column="4"
                                            Content="复制"
                                            Command="{Binding CopyTotpCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="网址" FontSize="12" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <SelectableTextBlock Grid.Column="0"
                                                         Text="{Binding EditUrl}"
                                                         VerticalAlignment="Center"
                                                         TextWrapping="Wrap" />
                                    <Button Grid.Column="2"
                                            Content="打开"
                                            Command="{Binding OpenUrlCommand}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="标签" FontSize="12" Opacity="0.6" />
                                <SelectableTextBlock Text="{Binding EditTags}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="备注" FontSize="12" Opacity="0.6" />
                                <SelectableTextBlock Text="{Binding EditNotes}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        Margin="0,8,0,0">
                                <Button Content="收藏 / 取消"
                                        Command="{Binding ToggleFavoriteCommand}" />
                                <Button Content="编辑" Command="{Binding BeginEditCommand}" />
                                <Button Content="删除" Command="{Binding DeleteEntryCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="10,4,4,4" Spacing="10" IsVisible="{Binding IsEditing}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="标题" FontSize="12" Opacity="0.6" />
                                <TextBox Text="{Binding EditTitle}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="用户名" FontSize="12" Opacity="0.6" />
                                <TextBox Text="{Binding EditUsername}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="密码" FontSize="12" Opacity="0.6" />
                                <Grid ColumnDefinitions="*,8,Auto">
                                    <TextBox Grid.Column="0"
                                             PasswordChar="●"
                                             RevealPassword="True"
                                             Text="{Binding EditPassword, Mode=TwoWay}" />
                                    <Button Grid.Column="2"
                                            Content="生成"
                                            Click="OnGeneratePasswordClicked" />
                                </Grid>
                                <ProgressBar Value="{Binding EditPasswordStrengthPercent}"
                                             Maximum="100"
                                             Height="6" />
                                <TextBlock Text="{Binding EditPasswordStrengthSummary}"
                                           FontSize="12"
                                           Opacity="0.75" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="网址" FontSize="12" Opacity="0.6" />
                                <TextBox Text="{Binding EditUrl}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTP 密钥（Base32）" FontSize="12" Opacity="0.6" />
                                <TextBox Text="{Binding EditTotpSecret}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="标签（逗号分隔）" FontSize="12" Opacity="0.6" />
                                <TextBox Text="{Binding EditTags}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="备注" FontSize="12" Opacity="0.6" />
                                <TextBox Text="{Binding EditNotes}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="90" />
                            </StackPanel>

                            <CheckBox Content="收藏" IsChecked="{Binding EditIsFavorite, Mode=TwoWay}" />

                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,0">
                                <Button Content="取消" Command="{Binding CancelEditCommand}" />
                                <Button Content="保存" Command="{Binding SaveEntryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Panel>
        </Grid>
        </Grid>

        <Border x:Name="ClipboardToast"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                CornerRadius="8"
                Padding="14,8"
                Background="#E6303030"
                BoxShadow="0 4 12 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding ClipboardToastText}"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <Button Content="立即清除"
                        Command="{Binding ClearClipboardNowCommand}" />
            </StackPanel>
        </Border>

        <Border x:Name="LockOverlay"
                IsVisible="False"
                Background="{DynamicResource SystemRegionBrush}">
            <Panel>
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="#40808080"
                        Padding="36,28"
                        BoxShadow="0 8 24 0 #30000000">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <TextBlock Text="🔒"
                                   FontSize="40"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="密码库已锁定"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="内容已在内存中清除，输入主密码即可继续。"
                                   FontSize="12"
                                   Opacity="0.65"
                                   HorizontalAlignment="Center" />
                        <Button Content="解锁"
                                MinWidth="120"
                                HorizontalAlignment="Center"
                                Click="OnUnlockClicked" />
                    </StackPanel>
                </Border>
            </Panel>
        </Border>
    </Panel>
</Window>
