<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:controls="using:AegisVault.App.Controls"
        xmlns:atom="https://atomui.net"
        x:Class="AegisVault.App.Views.TextPromptWindow"
        Icon="/Assets/app.png"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{atom:SharedTokenResource ColorBgContainer}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">
    <Grid RowDefinitions="40,*">
        <controls:AegisTitleBar x:Name="TitleBar" Grid.Row="0" ShowIcon="True" />

        <StackPanel Grid.Row="1" Margin="20" Spacing="12">
            <TextBlock x:Name="LabelText" Classes="field" />
            <atom:LineEdit x:Name="InputBox" />
            <TextBlock x:Name="NoteText"
                       FontSize="12"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <!-- Optional colour row (category editor only): the eight presets are
                 tiled for one-click picking, while a custom colour is mixed in an
                 inline picker — the AtomUI dropdown popup is window-clipped. -->
            <StackPanel x:Name="ColorSection" Spacing="8" IsVisible="False">
                <TextBlock Classes="field" Text="{loc:Str Main_CategoryColor}" />
                <StackPanel x:Name="ColorSwatchRow" Orientation="Horizontal" Spacing="6" />
                <atom:ColorPickerView x:Name="CustomPicker"
                                      AutomationProperties.AutomationId="CategoryColorPicker"
                                      IsPaletteGroupEnabled="False"
                                      IsAlphaEnabled="False"
                                      IsFormatEnabled="False"
                                      IsClearEnabled="False"
                                      Margin="0,4,0,0"
                                      IsVisible="False" />
            </StackPanel>

            <TextBlock x:Name="ErrorBlock"
                       Foreground="{atom:SharedTokenResource ColorError}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="False" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
                <atom:Button Content="{loc:Str Common_Cancel}" Click="OnCancelClicked" IsCancel="True" />
                <atom:Button ButtonType="Primary"
                             Content="{loc:Str Common_Ok}"
                             Click="OnOkClicked"
                             IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
