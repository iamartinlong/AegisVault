<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:AegisVault.App.Localization"
        x:Class="AegisVault.App.Views.TextPromptWindow"
        Icon="/Assets/app.png"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="12">
        <TextBlock x:Name="LabelText" FontSize="12" Opacity="0.7" />
        <TextBox x:Name="InputBox" />
        <TextBlock x:Name="ErrorBlock"
                   Foreground="#E5484D"
                   FontSize="12"
                   TextWrapping="Wrap"
                   IsVisible="False" />
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="{loc:Str Common_Cancel}" Click="OnCancelClicked" IsCancel="True" />
            <Button Content="{loc:Str Common_Ok}" Click="OnOkClicked" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
