<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:loc="using:AegisVault.App.Localization"
        x:Class="AegisVault.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/app.png"
        Title="{loc:Str Settings_Title}"
        Width="620" Height="720"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" Margin="28,24,28,0">
            <StackPanel Spacing="18">
                <TextBlock Text="{loc:Str Settings_SectionSecurity}" FontSize="16" FontWeight="SemiBold" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Str Settings_AutoLock}" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding AutoLockOptions}"
                              SelectedItem="{Binding SelectedAutoLock}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:AutoLockOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <CheckBox Content="{loc:Str Settings_LockOnMinimize}" IsChecked="{Binding LockOnMinimize, Mode=TwoWay}" />
                <CheckBox Content="{loc:Str Settings_LockOnScreenLock}" IsChecked="{Binding LockOnScreenLock, Mode=TwoWay}" />
                <CheckBox Content="{loc:Str Settings_LockOnSuspend}" IsChecked="{Binding LockOnSuspend, Mode=TwoWay}" />
                <CheckBox x:Name="ScreenGuardCheckBox"
                          IsEnabled="{Binding ScreenGuardSupported}"
                          IsChecked="{Binding DisableScreenCapture, Mode=TwoWay}"
                          Content="{loc:Str Settings_ScreenGuard}" />
                <TextBlock Text="{loc:Str Settings_ScreenGuardHint}"
                           FontSize="12" Opacity="0.6"
                           IsVisible="{Binding ScreenGuardSupported}" />

                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Str Settings_Clipboard}" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding ClipboardOptions}"
                              SelectedItem="{Binding SelectedClipboard}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:ClipboardOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="{loc:Str Settings_SectionMasterPassword}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Str Settings_NewMasterPassword}" FontSize="12" Opacity="0.7" />
                        <TextBox PasswordChar="●" Text="{Binding NewMasterPassword, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Str Settings_ConfirmNewMasterPassword}" FontSize="12" Opacity="0.7" />
                        <TextBox PasswordChar="●" Text="{Binding ConfirmMasterPassword, Mode=TwoWay}" />
                    </StackPanel>
                </Grid>
                <Button Content="{loc:Str Settings_ChangeMasterPassword}"
                        Command="{Binding ChangeMasterPasswordCommand}"
                        HorizontalAlignment="Right" />

                <TextBlock Text="{loc:Str Settings_SectionDeviceKey}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock FontSize="12" Opacity="0.75"
                           Text="{loc:Str Settings_DeviceKeySaved}"
                           IsVisible="{Binding HasDeviceKey}" />
                <TextBlock FontSize="12" Opacity="0.75"
                           Text="{loc:Str Settings_DeviceKeyNotSaved}"
                           IsVisible="{Binding !HasDeviceKey}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding DeviceKeySupported}">
                    <Button Content="{loc:Str Settings_RememberDevice}"
                            Command="{Binding RememberDeviceCommand}"
                            IsVisible="{Binding !HasDeviceKey}" />
                    <Button Content="{loc:Str Settings_ForgetDevice}"
                            Command="{Binding ForgetDeviceCommand}"
                            IsVisible="{Binding HasDeviceKey}" />
                </StackPanel>
                <TextBlock FontSize="12"
                           Opacity="0.6"
                           Text="{loc:Str Settings_DeviceKeyUnsupported}"
                           IsVisible="{Binding !DeviceKeySupported}" />

                <TextBlock Text="{loc:Str Settings_SectionAppearance}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Str Settings_Theme}" FontSize="12" Opacity="0.7" />
                    <ComboBox ItemsSource="{Binding ThemeOptions}"
                              SelectedItem="{Binding SelectedTheme}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="vm:ThemeOption">
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <CheckBox Content="{loc:Str Settings_ShowFloatingBall}"
                          IsChecked="{Binding ShowFloatingBall, Mode=TwoWay}" />

                <TextBlock Text="{loc:Str Settings_SectionLanguage}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <ComboBox ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguage}"
                          HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:LanguageOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Str Settings_LanguageRestart}" FontSize="12" Opacity="0.6" />

                <TextBlock Text="{loc:Str Settings_SectionGenerator}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <Slider Minimum="8" Maximum="64"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Value="{Binding GeneratorLength}" />
                <TextBlock Text="{Binding GeneratorLengthText}" FontSize="12" Opacity="0.7" />
                <CheckBox Content="{loc:Str Settings_GeneratorSymbols}" IsChecked="{Binding GeneratorSymbols, Mode=TwoWay}" />
                <CheckBox Content="{loc:Str Settings_GeneratorAmbiguous}" IsChecked="{Binding GeneratorExcludeAmbiguous, Mode=TwoWay}" />

                <TextBlock Text="{loc:Str Settings_SectionData}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:Str Settings_BackupTo}" Click="OnBackupClicked" />
                    <Button Content="{loc:Str Settings_ImportCsv}" Click="OnImportClicked" />
                    <Button Content="{loc:Str Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" />
                </StackPanel>
                <TextBlock Text="{loc:Str Settings_ImportHint}"
                           FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

                <TextBlock Text="{loc:Str Settings_SectionAbout}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding VersionText}" FontSize="12" Opacity="0.75" />
                <TextBlock Text="{loc:Str Settings_AboutLicense}"
                           FontSize="12"
                           Opacity="0.6"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Margin="28,12,28,24" Spacing="8">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#52C41A"
                       TextWrapping="Wrap"
                       MinHeight="18" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="{loc:Str Common_Close}" Click="OnCloseClicked" />
                <Button Content="{loc:Str Settings_SaveSettings}" Command="{Binding SaveCommand}" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
