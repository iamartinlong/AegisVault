<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AegisVault.App.ViewModels"
        xmlns:models="using:AegisVault.Core.Models"
        xmlns:loc="using:AegisVault.App.Localization"
        xmlns:atom="https://atomui.net"
        xmlns:antd="https://atomui.net/icons/antdesign"
        x:Class="AegisVault.App.Views.QuickAccessWindow"
        x:DataType="vm:QuickAccessViewModel"
        Title="QuickAccess"
        Width="540" SizeToContent="Height"
        MaxHeight="460" MinHeight="140"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="ListBox ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisSelectedBrush}" />
        </Style>
        <Style Selector="ListBox ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AegisHoverBrush}" />
        </Style>
        <Style Selector="atom|Button.row">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextSecondary}" />
        </Style>
    </Window.Styles>

    <Panel Margin="18">
        <Border CornerRadius="14"
                BorderThickness="1"
                BorderBrush="{DynamicResource AegisCardBorderBrush}"
                Background="{atom:SharedTokenResource ColorBgContainer}"
                Padding="14"
                BoxShadow="0 12 32 0 #40000000">
            <Grid RowDefinitions="Auto,*,Auto">
                <atom:LineEdit x:Name="SearchBox"
                               Grid.Row="0"
                               Text="{Binding SearchText}"
                               PlaceholderText="{loc:Str QuickAccess_Placeholder}" />

                <Panel Grid.Row="1" Margin="0,10,0,0" MinHeight="60">
                    <ListBox x:Name="ResultsList"
                             MaxHeight="300"
                             Background="Transparent"
                             ItemsSource="{Binding FilteredEntries}"
                             SelectedItem="{Binding SelectedEntry}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:PasswordEntry">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <atom:Button ButtonType="Text"
                                                         IsVisible="{Binding IsFavorite}"
                                                         IsHitTestVisible="False"
                                                         Width="16" Height="16"
                                                         MinWidth="0" MinHeight="0"
                                                         Padding="0"
                                                         Foreground="{atom:SharedTokenResource ColorPrimary}"
                                                         Icon="{antd:AntDesignIconProvider StarFilled}" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Username}"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="2"
                                                VerticalAlignment="Center">
                                        <atom:Button Classes="row"
                                                     ButtonType="Text"
                                                     Icon="{antd:AntDesignIconProvider UserOutlined}"
                                                     ToolTip.Tip="{loc:Str Main_CopyUsernameTip}"
                                                     Click="OnCopyUsernameClicked" />
                                        <atom:Button Classes="row"
                                                     ButtonType="Text"
                                                     Icon="{antd:AntDesignIconProvider KeyOutlined}"
                                                     ToolTip.Tip="{loc:Str Main_CopyPasswordTip}"
                                                     Click="OnCopyPasswordClicked" />
                                        <atom:Button Classes="row"
                                                     ButtonType="Text"
                                                     Icon="{antd:AntDesignIconProvider LinkOutlined}"
                                                     ToolTip.Tip="{loc:Str QuickAccess_CopyOpenTip}"
                                                     IsVisible="{Binding Url, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                     Click="OnCopyPasswordAndOpenClicked" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{loc:Str QuickAccess_NoResults}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="0.45"
                               IsVisible="{Binding !HasResults}" />
                </Panel>

                <TextBlock Grid.Row="2"
                           Text="{loc:Str QuickAccess_Hints}"
                           FontSize="11"
                           Opacity="0.45"
                           Margin="2,10,2,0"
                           HorizontalAlignment="Center" />
            </Grid>
        </Border>
    </Panel>
</Window>
